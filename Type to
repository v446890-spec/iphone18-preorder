<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>iPhone 18 Pre-Order Store</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
}

body{
  background:#f5f5f7;
  color:#1d1d1f;
}

header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(15px);
  border-bottom:1px solid #ddd;
  text-align:center;
  padding:18px 15px;
}

.logo{
  font-size:24px;
  font-weight:700;
}

.notice{
  background:#111;
  color:#fff;
  text-align:center;
  padding:9px;
  font-size:13px;
}

.hero{
  text-align:center;
  padding:60px 20px 35px;
}

.hero h1{
  font-size:52px;
  margin-bottom:12px;
}

.hero p{
  color:#666;
  font-size:19px;
}

.products{
  max-width:1100px;
  margin:auto;
  padding:20px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:25px;
}

.card{
  background:white;
  border-radius:28px;
  padding:30px;
  text-align:center;
  box-shadow:0 8px 30px rgba(0,0,0,.08);
}

.phone{
  width:145px;
  height:285px;
  margin:10px auto 25px;
  border-radius:38px;
  background:linear-gradient(145deg,#171717,#777);
  border:8px solid #111;
  position:relative;
  box-shadow:inset 0 0 20px rgba(255,255,255,.1);
}

.phone:before{
  content:"";
  position:absolute;
  width:72px;
  height:21px;
  background:#111;
  border-radius:20px;
  top:10px;
  left:50%;
  transform:translateX(-50%);
}

.phone.pro{
  background:linear-gradient(145deg,#252525,#999);
}

.phone.max{
  background:linear-gradient(145deg,#101010,#555);
}

.card h2{
  font-size:30px;
  margin-bottom:10px;
}

.card p{
  color:#666;
  font-size:17px;
  margin-bottom:15px;
}

.price{
  font-size:27px;
  font-weight:700;
  margin:15px 0 20px;
}

.select-box{
  width:100%;
  padding:13px;
  border:1px solid #ccc;
  border-radius:12px;
  margin:7px 0;
  font-size:16px;
  background:white;
}

.order-btn{
  width:100%;
  border:none;
  background:#0071e3;
  color:white;
  padding:15px;
  border-radius:30px;
  font-size:17px;
  font-weight:600;
  cursor:pointer;
  margin-top:10px;
}

.order-btn:hover{
  background:#0062c4;
}

.info{
  max-width:900px;
  margin:30px auto;
  padding:25px;
  background:white;
  border-radius:20px;
  text-align:center;
}

.info h3{
  margin-bottom:10px;
}

.info p{
  color:#666;
  line-height:1.6;
}

footer{
  text-align:center;
  padding:35px 20px;
  color:#777;
  font-size:13px;
}

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  z-index:500;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.modal-box{
  background:white;
  width:100%;
  max-width:480px;
  border-radius:25px;
  padding:30px;
  max-height:90vh;
  overflow:auto;
}

.modal-box h2{
  text-align:center;
  margin-bottom:20px;
}

.summary{
  background:#f1f1f1;
  border-radius:15px;
  padding:15px;
  margin-bottom:20px;
  line-height:1.7;
}

.close-btn{
  background:#eee;
  border:none;
  width:100%;
  padding:13px;
  border-radius:25px;
  margin-top:10px;
  font-size:16px;
}

.warning{
  font-size:12px;
  color:#666;
  margin-top:15px;
  line-height:1.5;
  text-align:center;
}

@media(max-width:600px){
  .hero h1{
    font-size:42px;
  }

  .card h2{
    font-size:27px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">iPhone 18 Store</div>
</header>

<div class="notice">
  Independent store • Not affiliated with Apple
</div>

<section class="hero">
  <h1>iPhone 18</h1>
  <p>Pre-order your preferred model.</p>
</section>

<section class="products">

  <!-- iPhone 18 Pro -->
  <div class="card">

    <div class="phone pro"></div>

    <h2>iPhone 18 Pro</h2>

    <p>Pro performance. Premium design.</p>

    <div class="price">₹1,29,900</div>

    <select id="proStorage" class="select-box">
      <option value="256 GB">256 GB</option>
      <option value="512 GB">512 GB</option>
      <option value="1 TB">1 TB</option>
    </select>

    <select id="proColor" class="select-box">
      <option value="Black">Black</option>
      <option value="Silver">Silver</option>
      <option value="Blue">Blue</option>
      <option value="Gold">Gold</option>
    </select>

    <button class="order-btn"
      onclick="openOrder('iPhone 18 Pro','129900','proStorage','proColor')">
      Pre-order Now
    </button>

  </div>


  <!-- iPhone 18 Pro Max -->
  <div class="card">

    <div class="phone max"></div>

    <h2>iPhone 18 Pro Max</h2>

    <p>Our largest Pro experience.</p>

    <div class="price">₹1,49,900</div>

    <select id="maxStorage" class="select-box">
      <option value="256 GB">256 GB</option>
      <option value="512 GB">512 GB</option>
      <option value="1 TB">1 TB</option>
    </select>

    <select id="maxColor" class="select-box">
      <option value="Black">Black</option>
      <option value="Silver">Silver</option>
      <option value="Blue">Blue</option>
      <option value="Gold">Gold</option>
    </select>

    <button class="order-btn"
      onclick="openOrder('iPhone 18 Pro Max','149900','maxStorage','maxColor')">
      Pre-order Now
    </button>

  </div>

</section>


<section class="info">

  <h3>Order & Payment</h3>

  <p>
    Select your model, storage and colour, then continue to the
    secure order form. Cash on Delivery is available as a payment
    option in the form.
  </p>

  <p style="margin-top:10px;">
    Online payments should be completed only through an authorised
    payment gateway. Never enter card number, CVV, OTP or UPI PIN
    directly into this website.
  </p>

</section>


<footer>
  © 2026 iPhone 18 Store · Independent store · Not affiliated with Apple
</footer>


<!-- ORDER MODAL -->

<div class="modal" id="orderModal">

  <div class="modal-box">

    <h2>Review Your Pre-order</h2>

    <div class="summary">

      <strong>Model:</strong>
      <span id="summaryModel"></span>
      <br>

      <strong>Storage:</strong>
      <span id="summaryStorage"></span>
      <br>

      <strong>Color:</strong>
      <span id="summaryColor"></span>
      <br>

      <strong>Price:</strong>
      ₹<span id="summaryPrice"></span>

    </div>

    <button class="order-btn" onclick="goToGoogleForm()">
      Continue to Order Form
    </button>

    <button class="close-btn" onclick="closeOrder()">
      Cancel
    </button>

    <div class="warning">
      Your personal details and payment information should only be
      entered on the official order/payment page. This website does
      not ask for card number, CVV, OTP or UPI PIN.
    </div>

  </div>

</div>


<script>

/*
  GOOGLE FORM LINK
*/
const GOOGLE_FORM_URL =
"https://docs.google.com/forms/d/e/1FAIpQLSdvWS2Qja4fEaSGCEI6rWAn2Q1nzvL-srNN8zg1aJ6PwMU_Ag/viewform?usp=sharing&ouid=105893566707999936866";


let selectedModel = "";
let selectedPrice = "";
let selectedStorage = "";
let selectedColor = "";


/*
  OPEN ORDER REVIEW
*/
function openOrder(model, price, storageId, colorId){

  selectedModel = model;
  selectedPrice = price;

  selectedStorage =
    document.getElementById(storageId).value;

  selectedColor =
    document.getElementById(colorId).value;

  document.getElementById("summaryModel").textContent =
    selectedModel;

  document.getElementById("summaryStorage").textContent =
    selectedStorage;

  document.getElementById("summaryColor").textContent =
    selectedColor;

  document.getElementById("summaryPrice").textContent =
    Number(selectedPrice).toLocaleString("en-IN");

  document.getElementById("orderModal").style.display =
    "flex";
}


/*
  CLOSE MODAL
*/
function closeOrder(){

  document.getElementById("orderModal").style.display =
    "none";
}


/*
  OPEN GOOGLE FORM
*/
function goToGoogleForm(){

  /*
    The Google Form contains the customer information,
    model, storage, colour and payment method questions.
  */

  window.open(GOOGLE_FORM_URL, "_blank");

}


/*
  CLOSE MODAL WHEN CLICKING OUTSIDE
*/
document.getElementById("orderModal").addEventListener(
  "click",
  function(event){

    if(event.target === this){
      closeOrder();
    }

  }
);

</script>

</body>
</html>
