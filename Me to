<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>iPhone 18 Pre-Order</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
}

body{
  background:#f5f5f7;
  color:#1d1d1f;
}

header{
  background:rgba(255,255,255,.96);
  border-bottom:1px solid #ddd;
  padding:16px 24px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:20;
}

.logo{
  font-size:25px;
  font-weight:700;
}

.notice{
  background:#111;
  color:white;
  text-align:center;
  padding:9px;
  font-size:13px;
}

.hero{
  text-align:center;
  padding:65px 20px 40px;
}

.hero h1{
  font-size:58px;
  margin-bottom:12px;
}

.hero p{
  color:#666;
  font-size:21px;
}

.products{
  max-width:1100px;
  margin:auto;
  padding:25px 20px 70px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:28px;
}

.card{
  background:white;
  border-radius:30px;
  padding:35px 25px;
  text-align:center;
  box-shadow:0 8px 30px rgba(0,0,0,.08);
}

.phone{
  width:150px;
  height:300px;
  margin:10px auto 30px;
  border:10px solid #111;
  border-radius:40px;
  background:linear-gradient(145deg,#222,#777);
  position:relative;
}

.phone:before{
  content:"";
  position:absolute;
  top:15px;
  left:50%;
  transform:translateX(-50%);
  width:70px;
  height:23px;
  background:#111;
  border-radius:20px;
}

.phone.pro{
  background:linear-gradient(145deg,#202020,#888);
}

.phone.max{
  height:325px;
  width:160px;
}

.card h2{
  font-size:30px;
  margin-bottom:10px;
}

.card p{
  color:#666;
  font-size:17px;
  margin-bottom:18px;
}

.price{
  font-size:27px;
  font-weight:700;
  margin-bottom:20px;
}

select{
  width:100%;
  padding:14px;
  border:1px solid #ccc;
  border-radius:12px;
  background:white;
  font-size:16px;
  margin-bottom:12px;
}

button{
  width:100%;
  border:none;
  border-radius:14px;
  padding:15px;
  font-size:17px;
  font-weight:600;
  cursor:pointer;
}

.order-btn{
  background:#0071e3;
  color:white;
}

.order-btn:hover{
  background:#0065ca;
}

.cod-btn{
  background:#198754;
  color:white;
  margin-top:10px;
}

.footer{
  text-align:center;
  padding:35px 20px;
  background:#111;
  color:#aaa;
  font-size:13px;
}

/* MODAL */

.overlay{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  z-index:100;
  overflow:auto;
  padding:30px 15px;
}

.modal{
  background:white;
  max-width:620px;
  margin:30px auto;
  border-radius:30px;
  padding:30px;
  position:relative;
}

.close{
  position:absolute;
  right:20px;
  top:15px;
  width:40px;
  height:40px;
  border-radius:50%;
  background:#eee;
  font-size:25px;
}

.modal h2{
  font-size:34px;
  margin-bottom:10px;
}

.selected{
  background:#f2f2f2;
  padding:16px;
  border-radius:14px;
  margin:20px 0;
  font-size:16px;
}

label{
  display:block;
  font-weight:600;
  margin:17px 0 7px;
}

input{
  width:100%;
  padding:15px;
  border:1px solid #ccc;
  border-radius:12px;
  font-size:16px;
}

.payment-box{
  margin-top:20px;
  padding:18px;
  border:1px solid #ddd;
  border-radius:16px;
}

.payment-option{
  display:flex;
  align-items:center;
  gap:10px;
  margin:12px 0;
  font-weight:600;
}

.payment-option input{
  width:auto;
}

.safe{
  margin-top:18px;
  padding:15px;
  border-radius:14px;
  background:#fff7df;
  color:#765900;
  font-size:14px;
  line-height:1.5;
}

.submit{
  margin-top:20px;
  background:#0071e3;
  color:white;
}

.google{
  margin-top:12px;
  background:#673ab7;
  color:white;
}

.success{
  display:none;
  margin-top:20px;
  background:#e7f8ec;
  color:#176b32;
  padding:18px;
  border-radius:14px;
  line-height:1.5;
}

@media(max-width:600px){
  header{
    padding:14px 16px;
  }

  .logo{
    font-size:20px;
  }

  header .small{
    font-size:11px;
  }

  .hero{
    padding:45px 15px 25px;
  }

  .hero h1{
    font-size:43px;
  }

  .hero p{
    font-size:18px;
  }

  .products{
    padding:15px 14px 50px;
  }

  .modal{
    padding:25px 20px;
    border-radius:25px;
  }

  .modal h2{
    font-size:29px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">iPhone 18 Pre-Order</div>
  <div class="small">Independent Store</div>
</header>

<div class="notice">
  Independent store • Not affiliated with Apple
</div>

<section class="hero">
  <h1>iPhone 18</h1>
  <p>Choose your preferred model and submit a pre-order request.</p>
</section>

<section class="products">

  <!-- iPhone 18 Pro -->
  <div class="card">

    <div class="phone pro"></div>

    <h2>iPhone 18 Pro</h2>
    <p>Pro performance. Premium design.</p>

    <div class="price">₹1,29,900</div>

    <select id="proStorage">
      <option value="256 GB">256 GB</option>
      <option value="512 GB">512 GB</option>
      <option value="1 TB">1 TB</option>
    </select>

    <select id="proColor">
      <option value="Silver">Silver</option>
      <option value="Black">Black</option>
      <option value="Gold">Gold</option>
    </select>

    <button class="order-btn"
      onclick="openOrder('iPhone 18 Pro','129900','proStorage','proColor')">
      Pre-Order
    </button>

  </div>


  <!-- iPhone 18 Pro Max -->
  <div class="card">

    <div class="phone max"></div>

    <h2>iPhone 18 Pro Max</h2>
    <p>Our largest Pro experience.</p>

    <div class="price">₹1,49,900</div>

    <select id="maxStorage">
      <option value="256 GB">256 GB</option>
      <option value="512 GB">512 GB</option>
      <option value="1 TB">1 TB</option>
    </select>

    <select id="maxColor">
      <option value="Silver">Silver</option>
      <option value="Black">Black</option>
      <option value="Gold">Gold</option>
    </select>

    <button class="order-btn"
      onclick="openOrder('iPhone 18 Pro Max','149900','maxStorage','maxColor')">
      Pre-Order
    </button>

  </div>

</section>


<!-- ORDER MODAL -->

<div class="overlay" id="orderOverlay">

  <div class="modal">

    <button class="close" onclick="closeOrder()">×</button>

    <h2>Pre-Order Details</h2>

    <div class="selected" id="selectedProduct">
      Product details
    </div>

    <label>Full Name *</label>
    <input
      type="text"
      id="customerName"
      placeholder="Enter your full name"
      required
    >

    <label>Mobile Number *</label>
    <input
      type="tel"
      id="customerMobile"
      placeholder="Enter mobile number"
      maxlength="10"
      required
    >

    <label>Email</label>
    <input
      type="email"
      id="customerEmail"
      placeholder="Enter email address"
    >

    <label>Delivery Address *</label>
    <input
      type="text"
      id="customerAddress"
      placeholder="House / Street / City / PIN"
      required
    >

    <div class="payment-box">

      <strong>Payment Method</strong>

      <label class="payment-option">
        <input
          type="radio"
          name="payment"
          value="COD"
          checked
        >
        Cash on Delivery (COD)
      </label>

      <label class="payment-option">
        <input
          type="radio"
          name="payment"
          value="ONLINE"
        >
        Online Payment
      </label>

    </div>

    <div class="safe">
      🔒 <strong>Payment Safety</strong><br>
      This website does not collect or store card numbers,
      CVV, OTP or UPI PIN. For real online payments,
      use an authorized payment gateway hosted checkout.
    </div>

    <button class="submit" onclick="continueOrder()">
      Continue
    </button>

    <button class="google" onclick="openGoogleForm()">
      Open Google Order Form
    </button>

    <div class="success" id="successBox"></div>

  </div>

</div>


<footer class="footer">
  © 2026 Independent iPhone 18 Pre-Order Store<br>
  Not affiliated with or endorsed by Apple Inc.
</footer>


<script>

/* ================================
   YOUR GOOGLE FORM
================================ */

const GOOGLE_FORM_URL =
"https://docs.google.com/forms/d/e/1FAIpQLSdvWS2Qja4fEaSGCEI6rWAn2Q1nzvL-srNN8zg1aJ6PwMU_Ag/viewform?usp=sharing";


let selectedModel = "";
let selectedPrice = "";
let selectedStorage = "";
let selectedColor = "";


/* ================================
   OPEN ORDER WINDOW
================================ */

function openOrder(model, price, storageId, colorId){

  selectedModel = model;
  selectedPrice = price;

  selectedStorage =
    document.getElementById(storageId).value;

  selectedColor =
    document.getElementById(colorId).value;

  document.getElementById("selectedProduct").innerHTML =
    "<strong>" + selectedModel + "</strong><br>" +
    "Storage: " + selectedStorage + "<br>" +
    "Color: " + selectedColor + "<br>" +
    "Price: ₹" + Number(selectedPrice).toLocaleString("en-IN");

  document.getElementById("orderOverlay").style.display = "block";

  document.body.style.overflow = "hidden";
}


/* ================================
   CLOSE
================================ */

function closeOrder(){

  document.getElementById("orderOverlay").style.display = "none";

  document.body.style.overflow = "auto";
}


/* ================================
   CONTINUE ORDER
================================ */

function continueOrder(){

  const name =
    document.getElementById("customerName").value.trim();

  const mobile =
    document.getElementById("customerMobile").value.trim();

  const email =
    document.getElementById("customerEmail").value.trim();

  const address =
    document.getElementById("customerAddress").value.trim();

  const payment =
    document.querySelector(
      'input[name="payment"]:checked'
    ).value;


  if(name === ""){
    alert("Please enter your name.");
    return;
  }

  if(!/^[0-9]{10}$/.test(mobile)){
    alert("Please enter a valid 10-digit mobile number.");
    return;
  }

  if(address === ""){
    alert("Please enter your delivery address.");
    return;
  }


  /*
    COD FLOW
  */

  if(payment === "COD"){

    const orderId =
      "RY18-" +
      Math.floor(100000 + Math.random() * 900000);

    document.getElementById("successBox").style.display = "block";

    document.getElementById("successBox").innerHTML =
      "<strong>✓ COD Pre-Order Ready</strong><br><br>" +

      "Order ID: <strong>" + orderId + "</strong><br>" +

      "Product: " + selectedModel + "<br>" +

      "Storage: " + selectedStorage + "<br>" +

      "Color: " + selectedColor + "<br>" +

      "Amount: ₹" +
      Number(selectedPrice).toLocaleString("en-IN") +

      "<br><br>" +

      "Now open the Google Order Form and submit your customer details."
      ;

    setTimeout(function(){

      openGoogleForm();

    },1200);

  }

  /*
    ONLINE PAYMENT
  */

  else{

    alert(
      "Online payment gateway is not connected yet. " +
      "Please use COD or connect an authorized payment gateway."
    );

  }

}


/* ================================
   GOOGLE FORM
================================ */

function openGoogleForm(){

  window.open(
    GOOGLE_FORM_URL,
    "_blank"
  );

}


/* ================================
   CLOSE ON BACKGROUND CLICK
================================ */

document.getElementById("orderOverlay")
.addEventListener("click", function(e){

  if(e.target === this){
    closeOrder();
  }

});

</script>

</body>
</html>
